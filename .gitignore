# -------------------------------
# PowerLog – Git ignore rules
# -------------------------------

# ---- Node / npm ----
node_modules/
*.tgz

# ---- Vite build output ----
dist/
dist-ssr/
.vite/

# ---- Release artifacts ----
release/

# ---- Environment / secrets ----
.env
.env.*
!.env.example
*.local

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Tauri / Rust ----
src-tauri/target/
src-tauri/gen/schemas/

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS / Explorer ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
*.lnk